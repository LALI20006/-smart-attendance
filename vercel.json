{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/student/dashboard",
      "destination": "/student.html"
    },
    {
      "source": "/student",
      "destination": "/student.html"
    },
    {
      "source": "/faculty/dashboard",
      "destination": "/faculty.html"
    },
    {
      "source": "/faculty",
      "destination": "/faculty.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/admin.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/logs",
      "destination": "/logs.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    }
  ]
}
