# ========================================================
# Smart Attendance Platform — Production Environment Variables
# ========================================================

# Application Port and Host
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Cloud Database URL (PostgreSQL)
# Works with Neon, Supabase, Render PostgreSQL, Railway, AWS RDS, GCP Cloud SQL
# Example: postgresql://postgres:your_password@ep-sample-12345.us-east-2.aws.neon.tech/attendance?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/attendance?sslmode=require

# JWT Authentication Secret (Generate a 32+ character random string)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# CORS Allowed Origin (Leave as * for open web app, or your custom domain)
# Example: https://smart-attendance-platform.onrender.com
CORS_ORIGIN=*

# Public Facing Application URL
# Example: https://smart-attendance-platform.onrender.com
APP_URL=https://your-deployed-attendance-app.com

# (Optional) SMTP Mail Server for Password Reset Emails
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-specific-password
MAIL_SECURE=false
FROM_EMAIL=no-reply@your-attendance-app.com
