# ===================================================================
# SMART ATTENDANCE PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION
# ===================================================================

# Server Environment
NODE_ENV=production
PORT=3000

# Security Keys
JWT_SECRET=attendpro_production_secure_jwt_secret_key_2026_campus

# Custom Domain & CORS
APP_URL=https://attendence.in.com
CORS_ORIGIN=https://attendence.in.com,https://www.attendence.in.com,https://api.attendence.in.com

# -------------------------------------------------------------------
# PRODUCTION CLOUD MYSQL DATABASE CONFIGURATION
# (Choose Option A: Connection URL OR Option B: Individual Parameters)
# -------------------------------------------------------------------

# Option A: Standard Cloud MySQL Connection URI (TiDB Cloud / Aiven / Railway / PlanetScale)
DATABASE_URL=mysql://username:password@gateway.tidbcloud.com:4000/smart_attendance?ssl={"rejectUnauthorized":true}

# Option B: Individual Cloud Database Parameters (e.g. AWS RDS / GCP Cloud SQL)
# MYSQL_HOST=gateway.tidbcloud.com
# MYSQL_PORT=4000
# MYSQL_USER=your_cloud_user
# MYSQL_PASSWORD=your_cloud_password
# MYSQL_DATABASE=smart_attendance
# MYSQL_SSL=true

# Email Service (Optional: for password reset emails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=admin@campus.edu
MAIL_PASS=your-app-specific-password
MAIL_SECURE=false
FROM_EMAIL=noreply@campus.edu
